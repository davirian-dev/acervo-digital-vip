  </div>

  <script>
    // 1. Contador Regressivo de Urgência
    let tempoRestante = 14 * 60 + 48;
    const timerEl = document.getElementById('countdown-timer');
    setInterval(() => {
      if (tempoRestante > 0) {
        tempoRestante--;
        const min = Math.floor(tempoRestante / 60);
        const sec = tempoRestante % 60;
        if (timerEl) {
          timerEl.textContent = `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
        }
      }
    }, 1000);

    // 2. Busca Instantânea de Cursos
    function filtrarCursos() {
      const termo = document.getElementById('input-busca').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.curso-card');
      let visiveis = 0;

      cards.forEach(card => {
        const dados = card.getAttribute('data-titulo').toLowerCase();
        if (dados.includes(termo)) {
          card.classList.remove('hidden');
          visiveis++;
        } else {
          card.classList.add('hidden');
        }
      });

      const contador = document.getElementById('contador-busca');
      if (contador) contador.textContent = visiveis;
    }

    // 3. Filtro por Categorias
    function filtrarCategoria(cat) {
      document.querySelectorAll('.btn-categoria').forEach(btn => {
        btn.classList.remove('bg-emerald-500', 'text-black', 'border-emerald-400');
        btn.classList.add('bg-white/5', 'text-zinc-300', 'border-white/10');
      });

      event.target.classList.add('bg-emerald-500', 'text-black', 'border-emerald-400');
      event.target.classList.remove('bg-white/5', 'text-zinc-300', 'border-white/10');

      const blocos = document.querySelectorAll('.categoria-bloco');
      blocos.forEach(bloco => {
        if (cat === 'todas' || bloco.getAttribute('data-cat') === cat) {
          bloco.style.display = 'block';
        } else {
          bloco.style.display = 'none';
        }
      });
    }

    // 4. Modal Pix Personalizado por Curso
    function abrirModalPixCurso(nomeCurso) {
      const modal = document.getElementById('modal-pix');
      if (modal) {
        modal.classList.remove('hidden');
        const tit = modal.querySelector('h3');
        if (tit) tit.textContent = 'Destrave: ' + nomeCurso;
      }
    }

    // 5. Acordeão de FAQ
    function toggleFaq(btn) {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('.faq-icon');
      const isHidden = content.classList.contains('hidden');

      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => {
        i.textContent = '+';
        i.classList.remove('rotate-45');
      });

      if (isHidden) {
        content.classList.remove('hidden');
        icon.textContent = '×';
        icon.classList.add('rotate-45');
      }
    }

    // 6. Shader Leve Profitize Canvas2D (Micropartículas & Nebulosa Orgânica)
    (function initCanvasShader() {
      const canvas = document.getElementById('bg-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w, h;
      const particles = [];
      const numParticles = 35;

      function resize() {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resize);
      resize();

      for (let i = 0; i < numParticles; i++) {
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: Math.random() * 2 + 0.8,
          dx: (Math.random() - 0.5) * 0.3,
          dy: (Math.random() - 0.5) * 0.3,
          alpha: Math.random() * 0.5 + 0.2
        });
      }

      function draw() {
        ctx.clearRect(0, 0, w, h);
        
        // Glow sutil
        const grad = ctx.createRadialGradient(w*0.3, h*0.2, 50, w*0.3, h*0.2, w*0.6);
        grad.addColorStop(0, 'rgba(16, 185, 129, 0.04)');
        grad.addColorStop(1, 'transparent');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, h);

        particles.forEach(p => {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(167, 243, 208, ${p.alpha})`;
          ctx.fill();

          p.x += p.dx;
          p.y += p.dy;

          if (p.x < 0) p.x = w;
          if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h;
          if (p.y > h) p.y = 0;
        });

        requestAnimationFrame(draw);
      }
      draw();
    })();

    // 7. Notificação Social de Compras Recentes
    const compradores = [
      { nome: 'Carlos M. de São Paulo', tempo: 'há 1 min' },
      { nome: 'Mariana R. de Belo Horizonte', tempo: 'há 3 min' },
      { nome: 'Rodrigo P. de Salvador', tempo: 'há 4 min' },
      { nome: 'Fernanda L. de Curitiba', tempo: 'há 2 min' },
      { nome: 'Guilherme B. de Brasília', tempo: 'há 6 min' }
    ];
    let compIdx = 0;

    function mostrarToastSocial() {
      const toast = document.getElementById('toast-social');
      const nomeEl = document.getElementById('toast-social-nome');
      if (!toast || !nomeEl) return;

      const comp = compradores[compIdx % compradores.length];
      compIdx++;
      nomeEl.textContent = comp.nome;
      toast.querySelector('span').textContent = '• ' + comp.tempo;

      toast.classList.remove('translate-y-32', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-32', 'opacity-0');
      }, 4500);
    }
    setTimeout(mostrarToastSocial, 3000);
    setInterval(mostrarToastSocial, 16000);
  </script>


  <!-- WIDGET LATERAL FLUTUANTE: OFERTA NINJA VIP (Estilo ninjacursos.com.br) -->
  <div id="widget-oferta-vip" class="fixed bottom-6 right-5 z-40 flex flex-col items-end gap-2 transition-all duration-300">
