<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ACERVO DIGITAL VIP — +68 Categorias de Cursos e Ferramentas</title>
  <meta name="description" content="Acesse o maior acervo organizado de cursos, ferramentas, drives e automações no Telegram. Mais de 2.000 conteúdos com acesso vitalício por apenas R$ 9,90.">
  <link rel="canonical" href="https://acervodigitalvip.vercel.app/">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">
  <meta name="theme-color" content="#06070a">
  <meta name="color-scheme" content="dark">
  <meta name="darkreader-lock">
  
  <!-- Open Graph -->
  <meta property="og:title" content="ACERVO DIGITAL VIP — Acesso Vitalício a Cursos e Ferramentas">
  <meta property="og:description" content="Mais de 68 categorias de cursos, ferramentas, drives e materiais completos por apenas R$ 9,90 taxa única.">
  <meta property="og:url" content="https://acervodigitalvip.vercel.app/">
  <meta property="og:type" content="website">

  <!-- Tailwind via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            bg: '#06070a',
          }
        }
      }
    }
  </script>

  <!-- Schema JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "ACERVO DIGITAL VIP - Acesso Vitalício",
    "description": "Repositório completo com mais de 68 tópicos de cursos, drives e ferramentas digitais no Telegram.",
    "brand": {
      "@type": "Brand",
      "name": "ACERVO DIGITAL VIP"
    },
    "offers": {
      "@type": "Offer",
      "price": "9.90",
      "priceCurrency": "BRL",
      "availability": "https://schema.org/InStock"
    }
  }
  </script>

  <style>
    body {
      background-color: #06070a;
      color: #f4f4f5;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow-x: hidden;
    }
    .glass-panel {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    .glass-card {
      background: rgba(18, 18, 24, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.09);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .glass-card:hover {
      border-color: rgba(255, 255, 255, 0.35);
      transform: translateY(-4px);
    }
    .carrossel-scroll::-webkit-scrollbar {
      height: 6px;
    }
    .carrossel-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.02);
      border-radius: 9999px;
    }
    .carrossel-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 9999px;
    }
    
    @keyframes marquee {
      0% { transform: translateX(100%); }
      100% { transform: translateX(-100%); }
    }
    .animate-marquee {
      display: inline-block;
      white-space: nowrap;
      animation: marquee 35s linear infinite;
    }
    .animate-marquee:hover {
      animation-play-state: paused;
    }

    .carrossel-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.3);
    }
  </style>
</head>
<body class="relative min-h-screen flex flex-col justify-between selection:bg-emerald-500 selection:text-black">
  
